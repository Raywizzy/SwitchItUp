{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "excludeFiles": "{tests/**,__pycache__/**,src/**/__pycache__/**,data/uploads/**,assets/**,reports/**}"
    }
  }
}
